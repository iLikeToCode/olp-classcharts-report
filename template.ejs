<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title><%= report.info.name %> - ClassCharts Report</title>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        @media print {
            body {
                margin: 0;
            }

            .page {
                page-break-after: always;
                break-after: page;
                height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            canvas {
                width: 100vw;
                height: 100vh;
            }
        }

        .summary {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 20px;
        }

        #summary-text {
            flex: 1;
        }

        .summary table {
            flex-shrink: 0;
        }

        table {
            background-color: white;
            border-collapse: collapse;
        }

        th {
            background-color: #eee;
        }

        td, th {
            padding: 3px;
            border: 1px solid #000000;
        }
    </style>
</head>
<body>
    <div class="summary">
        <div id="summary-text">
            <h1>ClassCharts Report</h1>

            <p>Name: <%= report.info.name %></p>
            <p>Total positive points: <%= report.summary.positive %></p>
            <p>Total positive points from lessons: <%= report.summary.positive_lessons %></p>
        </div>

        <table border="1">
            <tr>
                <th>Teacher</th>
                <th>Total Points</th>
                <th>Total Points From Lessons</th>
            </tr>
            <% for (const [teacher, values] of Object.entries(report.teachers)) { %>
                <tr>
                    <td><%= teacher %></td>
                    <td><%= values.points %></td>
                    <td><%= values.points_lessons == 0 ? "" : values.points_lessons %></td>
                </tr>
            <% } %>
        </table>
    </div>

    <canvas id="timeline"></canvas>
    <canvas id="teachers"></canvas>

    <script>
        const labels_timeline = <%- JSON.stringify(report.timeline.labels) %>;
        const positive = <%- JSON.stringify(report.timeline.positive) %>;
        const positive_lessons = <%- JSON.stringify(report.timeline.positive_lessons) %>;
        const total_positive = <%- JSON.stringify(report.summary.positive) %>;
        const total_positive_lessons = <%- JSON.stringify(report.summary.positive_lessons) %>;
        const total_positive_not_lessons = total_positive - total_positive_lessons;

        new Chart(document.getElementById("timeline"), {
            type: "bar",
            data: {
                labels: labels_timeline,
                datasets: [
                    {
                        label: "Positive Points",
                        data: positive
                    },
                    {
                        label: "Positive Points From Lessons",
                        data: positive_lessons
                    }
                ]
            }
        });

        const teachers = <%- JSON.stringify(report.teachers) %>

        const teachers_vals = Object.values(teachers)

        const teachers_no_lessons = teachers_vals.map(teacher => teacher.points)
        const teachers_lessons = teachers_vals.map(teacher => teacher.points_lessons)

        new Chart(document.getElementById("teachers"), {
            type: "bar",
            data: {
                labels: Object.keys(teachers),
                datasets: [
                    {
                        label: "Positive Points",
                        data: teachers_no_lessons
                    },
                    {
                        label: "Positive Points From Lessons",
                        data: teachers_lessons
                    }
                ]
            }
        });
    </script>
</body>
</html>